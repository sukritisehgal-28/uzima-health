# Copy to .env. Everything runs locally without credentials; use the flags below to enable AWS integrations.

# --- OpenAI text through AWS Bedrock (uses AWS credentials, no OpenAI API key) ---
USE_BEDROCK=0                # set 1 after AWS credentials and bedrock:InvokeModel access are verified
BEDROCK_MODEL_ID=openai.gpt-oss-20b-1:0
OPENAI_MAX_CONCURRENT=5

# --- Twilio: speech recognition/synthesis, Bedrock for interpretation ---
TWILIO_ENABLED=0              # set 1 only for an intentional live phone rehearsal
VOICE_PROVIDER=bedrock_gather  # default: no direct OpenAI key needed
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
PUBLIC_HOST=                  # HTTPS tunnel hostname for public gateway port 8005; no scheme
# Backup voice provider (Option B): one of
RETELL_API_KEY=
VAPI_API_KEY=

# --- Demo phones (verified in Twilio; teammates only, never real hospitals) ---
DEMO_HOSPITAL_PHONES=         # comma list, nearest hospitals get these: "+1SAKSHI,+1SUKRITI,+1JUDGE" (trial: 5 calls at once)
DEMO_HOSPITAL_PHONE=          # legacy single phone, used if DEMO_HOSPITAL_PHONES is empty
DEMO_SENDING_DOCTOR_PHONE=    # referring clinician (Udit): Connect dials this into the winning hospital's call
DEMO_ACCEPTING_DOCTOR_PHONE=  # separate accepting doctor: hears the summary, then joins Udit in a conference

# --- Optional legacy direct voice: VOICE_PROVIDER=openai_realtime ---
# Uses OpenAI directly; not needed for the default Bedrock speech path.
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=alloy
LIVE_CALL_MAX_S=240

# --- Shared AWS credentials; USE_AWS separately enables storage and road times ---
USE_AWS=0
AWS_REGION=us-west-2
# For the hackathon, use temporary credentials or a configured AWS_PROFILE.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
DYNAMODB_TABLE=project-uzima
AWS_LOCATION_ROUTE_CALCULATOR=project-uzima-routes
AWS_LOCATION_MAP=project-uzima-map
LAUNCH_MODE=local             # local = in-process swarm; k8s = one Job per hospital
AGENT_IMAGE=project-uzima/agent:latest
K8S_NAMESPACE=project-uzima

# --- Handoff twin + insurance (Stedi mock mode) ---
STEDI_TEST_API_KEY=           # test key only; mock members below come from Stedi's docs
STEDI_MOCK_PAYER_ID=
STEDI_MOCK_MEMBER_ID=
STEDI_MOCK_FIRST=
STEDI_MOCK_LAST=
STEDI_MOCK_DOB=
SHL_VIEWER_URL=               # empty = the built-in viewer at HANDOFF_PUBLIC_URL/view; or any SMART Health Links viewer
HANDOFF_PUBLIC_URL=           # public https address of the handoff service (the public gateway tunnel to port 8005) so phones can open tickets and records

# --- Apple Wallet transfer ticket (optional; without these the web ticket is used) ---
APPLE_PASS_TYPE_ID=           # e.g. pass.org.uzima.transfer (Apple Developer > Identifiers > Pass Type IDs)
APPLE_TEAM_ID=                # 10-character Apple Developer Team ID
APPLE_PASS_P12=               # path to the Pass Type ID certificate + key exported as .p12
APPLE_PASS_P12_PASSWORD=
APPLE_WWDR_CERT=              # path to Apple's WWDR G4 intermediate certificate (.cer or .pem)
DEMO_NPI=1999999984

# --- Demo behavior ---
SIM_TIME_SCALE=1              # 1 = simulated answers land over 5-45 s; 0 = instant
SIM_A1_ANSWER=random          # available | declined | random (used only when there is no live call)
SWARM_TIMEOUT_SECONDS=90
LIVE_CALL_TIMEOUT_S=300

# --- Service URLs (defaults shown) ---
ORCHESTRATOR_URL=http://localhost:8000
OPENAI_SYNC_URL=http://localhost:8001
TWILIO_SYNC_URL=http://localhost:8002
COLLECTOR_URL=http://localhost:8003
HANDOFF_URL=http://localhost:8004
